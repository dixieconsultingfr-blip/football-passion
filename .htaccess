ErrorDocument 404 /404.php

RewriteEngine On

# Force www -> non-www (canonique : football-passion.fr, sans www)
RewriteCond %{HTTP_HOST} ^www\.football-passion\.fr$ [NC]
RewriteRule ^(.*)$ https://football-passion.fr/$1 [L,R=301]

RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Anciennes URLs /blog/?slug=mon-slug -> redirection 301 directe vers /blog/mon-slug (une seule étape)
RewriteCond %{QUERY_STRING} ^slug=([a-z0-9-]+)$ [NC]
RewriteRule ^blog/?$ /blog/%1? [R=301,L]

# URL propre pour les articles : /blog/mon-slug -> /blog/index.php?slug=mon-slug
RewriteRule ^blog/([a-z0-9-]+)/?$ blog/index.php?slug=$1 [L,QSA]
